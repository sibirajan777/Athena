# ===========================================================================
# Athena Configuration Template
# Copy this file to .env and fill in your API keys
# ===========================================================================

# Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key for Session Authentication (generate any random string)
JWT_SECRET_KEY=athena_secret_jwt_key_change_me_in_production

# Server Configuration
PORT=8000
HOST=127.0.0.1
