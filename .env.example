# ==============================================================================
# Athena AI Knowledge Assistant - Environment Variables Configuration
# ==============================================================================

# 1. Google Gemini API (Required for multi-model synthesis & reasoning)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. JWT Secret Key (Required for user authentication sessions)
# Generate any secure random string: openssl rand -hex 32
JWT_SECRET=athena-super-secret-jwt-key-2026-production-vault

# 3. Chroma Cloud Hosted Vector Database (Recommended for Serverless / Vercel)
# Sign up at: https://www.trychroma.com/
# Leave empty to automatically use local disk-persistent ChromaDB
CHROMA_API_KEY=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
